# Optionale Überschreibungen. Die docker-compose.yml hat Defaults
# (latest / 7077) und läuft auch ohne diese Datei.

# Docker-Image-Tag aus der CI, z. B. 20260831-41be9cc – oder "latest"
IMAGE_VERSION=latest

# Host-Port, unter dem die App erreichbar ist
HOST_PORT=7077

# Bugsink-DSN für das Fehlertracking (leer = ohne). Echter Wert nur in der
# Stack-Umgebung in Portainer, nie hier eintragen.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
